{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "../../node_modules/@types/react",
        "./node_modules/@types/react"
      ],
      "react-dom": [
        "../../node_modules/@types/react-dom",
        "./node_modules/@types/react-dom"
      ]
    }
  },
  "include": [
    "src",
    "../shared"
  ]
}
